# Names only. Never commit real values.

# Postgres connection string. Leave unset in development to use embedded Postgres in .data/.
DATABASE_URL=

# Single-server deployments only: store responses in embedded Postgres at this path.
HOBBI_EMBEDDED_DB_PATH=

# Required in production. Key for hashing IPs in the rate limiter. Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
